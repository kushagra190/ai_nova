# Copy this file to ".env" and fill in your real values.

# PostgreSQL connection string: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:password@localhost:5432/pharma_rca

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Any active Groq model works. Just change this one line to switch, e.g.:
#   GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-120b
